// Data model for the AI order aggregator MVP.
// Order status string values must stay in sync with
// packages/shared/src/statuses.ts (ORDER_STATUSES).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity ----------

model User {
  id               String              @id @default(uuid())
  phone            String              @unique
  name             String?
  // Which channel gets order/offer notifications — set to WHATSAPP the first
  // time someone reaches us through the WhatsApp bot, defaults to SMS for
  // web-only users.
  preferredChannel NotificationChannel @default(SMS)
  // Auto-detected from the language they actually write in (WhatsApp bot) or
  // set explicitly (web toggle) — see packages/shared/src/language.ts.
  preferredLanguage Language           @default(RU)
  // Stamped on every real inbound WhatsApp message (see
  // WhatsAppRouterService.resolveLanguage) — lets NotificationsService tell
  // whether Meta's 24h customer-service window is still open before
  // deciding free text vs. a pre-approved template message.
  lastInboundWhatsAppAt DateTime?
  createdAt        DateTime            @default(now())
  clientProfile    ClientProfile?
  supplierProfile  SupplierProfile?
  otpCodes         OtpCode[]
  trustedDevices   TrustedDevice[]
}

// One row per WhatsApp chat — WhatsApp has no browser-style session, so this
// is what remembers "which order/onboarding step is this phone number
// mid-way through" between messages.
model WhatsAppSession {
  id             String   @id @default(uuid())
  chatId         String   @unique // Green API chatId, e.g. "77011234567@c.us"
  phone          String
  flow           String   @default("client_order") // "client_order" today; "supplier_onboarding" etc. later
  currentOrderId String?
  stateData      Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([phone])
}

model TrustedDevice {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  deviceId   String
  verifiedAt DateTime @default(now())
  expiresAt  DateTime

  @@unique([userId, deviceId])
}

model OtpCode {
  id         String     @id @default(uuid())
  phone      String
  code       String
  purpose    OtpPurpose
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  ipAddress  String?
  deviceId   String?
  createdAt  DateTime   @default(now())
  User       User?      @relation(fields: [userId], references: [id])
  userId     String?

  @@index([phone, purpose])
}

enum OtpPurpose {
  CLIENT_LOGIN
  SUPPLIER_LOGIN
}

// ---------- Client ----------

model ClientProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  orders    Order[]
}

// ---------- Supplier ----------

model SupplierProfile {
  id                         String                 @id @default(uuid())
  userId                     String                 @unique
  user                       User                   @relation(fields: [userId], references: [id])
  companyName                String?
  rating                     Float                  @default(0)
  completedOrders            Int                    @default(0)
  cancelledOrders            Int                    @default(0)
  declinedAfterSelected      Int                    @default(0)
  responseSpeedAvgSeconds    Int?
  activityStatus             SupplierActivityStatus @default(ACTIVE)
  isBlocked                  Boolean                @default(false)
  // Null = the supplier is in our base but has never agreed to receive
  // anything: typically pre-loaded by an operator from a public directory.
  // They still take part in matching, but get a cold-invite message with a
  // privacy-safe order summary (no client phone/address) plus an opt-in
  // button — see MatchingService.dispatchToSupplier. Set the moment they
  // tap "Интересно", after which they're treated like any other supplier
  // and receive full order details including the client's contact.
  confirmedAt                DateTime?
  // Quiet-hours window for non-urgent order notifications (see
  // matching/quiet-hours.util.ts). Both null = not configured, falls back to
  // DispatchSettings'/env's global default. Both "00:00"/"23:59" = supplier
  // explicitly opted into round-the-clock. Urgent orders always bypass this.
  workingHoursStart          String?
  workingHoursEnd            String?
  acceptsUrgent              Boolean                @default(true)
  // First 10 order notifications each calendar month are free; beyond that,
  // sendWave() skips this supplier unless subscription.status is ACTIVE.
  // See billing/billing.service.ts.
  notificationsUsedThisMonth Int                    @default(0)
  quotaResetAt               DateTime               @default(now())
  lastQuotaReminderAt        DateTime?
  /// Что поставщик написал о себе своими словами: «У меня автокран 25тн,
  /// стрела 42 метра». Такой текст приходит в ответ на приглашение и раньше
  /// просто терялся — категория из справочника («Автокран») не заменяет его,
  /// по ней нельзя понять, подойдёт ли человек под конкретную заявку.
  /// Накапливается: люди пишут это в несколько сообщений подряд.
  selfDescription            String?
  selfDescriptionAt          DateTime?
  createdAt                  DateTime               @default(now())
  categories                 SupplierCategory[]
  serviceAreas               ServiceArea[]
  notifications              NotificationLog[]
  subscription               SupplierSubscription?
  kaspiPayments              KaspiPayment[]
  orderReplies               SupplierOrderReply[]
  invoices                   SubscriptionInvoice[]
  pendingNotifications       PendingSupplierNotification[]
}

model SupplierSubscription {
  id                 String          @id @default(uuid())
  supplierId         String          @unique
  supplier           SupplierProfile @relation(fields: [supplierId], references: [id])
  status             String          @default("NONE") // NONE | ACTIVE | EXPIRED
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  paymentProvider    String?
  paymentReference   String?         @unique
  autoRenew          Boolean         @default(false)
  /// Когда отправили «подписка заканчивается» по текущему периоду. Без этой
  /// отметки ежедневная проверка слала бы напоминание каждый день подряд.
  /// Сбрасывается при продлении — предупреждение о следующем периоде должно
  /// уйти заново.
  expiryNoticeAt     DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

enum SupplierActivityStatus {
  ACTIVE
  PAUSED
  BLOCKED
}

model SupplierCategory {
  id         String          @id @default(uuid())
  supplierId String
  supplier   SupplierProfile @relation(fields: [supplierId], references: [id])
  categoryId String
  category   Category        @relation(fields: [categoryId], references: [id])

  @@unique([supplierId, categoryId])
}

model ServiceArea {
  id         String          @id @default(uuid())
  supplierId String
  supplier   SupplierProfile @relation(fields: [supplierId], references: [id])
  city       String
  district   String?

  @@index([city, district])
}

// ---------- Categories / templates ----------

model Category {
  id                 String             @id @default(uuid())
  slug               String             @unique
  // Bilingual { ru, kk } — see packages/shared/src/language.ts.
  name               Json
  icon               String?
  examples           Json
  fields             Json
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  orders             Order[]
  supplierCategories SupplierCategory[]
}

// ---------- Orders ----------

model Order {
  id                          String             @id @default(uuid())
  number                      Int                @unique @default(autoincrement())
  // Nullable until publish: drafts are anonymous per ТЗ п.3.3 ("не должно
  // быть обязательной регистрации") — the order is claimed by a ClientProfile
  // only once the phone is confirmed at publish time.
  //
  // Исключение — заявки из WhatsApp: там номер известен с первого сообщения и
  // подтверждён самим фактом переписки, поэтому владелец проставляется сразу
  // (см. WhatsAppRouterService.ensureOrder). Иначе брошенный черновик выглядит
  // в админке как «нет телефона», хотя перезвонить есть куда.
  clientId                    String?
  client                      ClientProfile?     @relation(fields: [clientId], references: [id])
  categoryId                  String?
  category                    Category?          @relation(fields: [categoryId], references: [id])
  status                      String             @default("DRAFT")
  /// Откуда пришёл человек: нормализованный канал ("google", "2gis",
  /// "instagram", "direct") и страница, с которой он начал. Без этого после
  /// месяца рекламы нельзя сказать, какой канал принёс заказы, а какой сжёг
  /// бюджет. Заполняется один раз при создании черновика — по меткам в
  /// ссылке или, если их нет, по домену перехода.
  /// Где заявка оформлялась: WEB | WHATSAPP. Это не то же самое, что source:
  /// source отвечает «откуда человек пришёл» (google, 2gis, direct), а канал —
  /// «где он разговаривал». Смешивать нельзя: заявки из WhatsApp полезли бы в
  /// отчёт по рекламным источникам, которыми они не являются.
  channel                     String             @default("WEB")
  source                      String?
  sourceParams                Json?
  landingPath                 String?
  urgent                      Boolean            @default(false)
  fieldsData                  Json               @default("{}")
  progressPercent             Int                @default(0)
  addressFrom                 String?
  addressTo                   String?
  city                        String?
  district                    String?
  dateNeeded                  DateTime?
  timeWindow                  String?
  description                 String?
  publicToken                 String             @unique @default(uuid())
  publishedAt                 DateTime?
  completedAt                 DateTime?
  cancelledAt                 DateTime?
  cancelReason                String?
  clientRatingPositive        Boolean?
  clientRatingComment         String?
  repeatOfOrderId             String?
  repeatOfOrder               Order?             @relation("RepeatOrder", fields: [repeatOfOrderId], references: [id])
  repeats                     Order[]            @relation("RepeatOrder")
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
  photos                      Photo[]
  chatMessages                ChatMessage[]
  statusHistory               OrderStatusEvent[]
  supplierReplies             SupplierOrderReply[]
  dispatchWaves               DispatchWave[]
  pendingNotifications        PendingSupplierNotification[]
  prospectContacts             ProspectContact[]

  @@index([status])
  @@index([categoryId, city, district])
}

model ChatMessage {
  id        String          @id @default(uuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id])
  role      ChatMessageRole
  content   String
  createdAt DateTime        @default(now())
}

enum ChatMessageRole {
  USER
  ASSISTANT
}

model Photo {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  url       String
  createdAt DateTime @default(now())
}

model OrderStatusEvent {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  fromStatus String?
  toStatus   String
  actor      String?
  note       String?
  createdAt  DateTime @default(now())
}

// Records which suppliers got notified about an order and when — so a manual
// admin redispatch only reaches new suppliers, not ones already called.
model DispatchWave {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  waveNumber  Int
  supplierIds Json
  sentAt      DateTime @default(now())
}

// A supplier who matched an order but was outside their quiet-hours window
// at dispatch time — held here instead of sending immediately, then batched
// into one order_digest message per supplier when their window next opens
// (see MatchingService's @Cron flush). Urgent orders never create these rows.
model PendingSupplierNotification {
  id         String          @id @default(uuid())
  supplierId String
  supplier   SupplierProfile @relation(fields: [supplierId], references: [id])
  orderId    String
  order      Order           @relation(fields: [orderId], references: [id])
  createdAt  DateTime        @default(now())

  @@unique([supplierId, orderId])
  @@index([supplierId])
}

// PROSPECT-онбординг (прогрев поставщиков) — оператор вручную отправляет
// холодный контакт реальную опубликованную заявку ещё до какой-либо
// регистрации; согласие (нажатие кнопки в шаблоне) переводит номер в
// существующий FSM регистрации поставщика. Не имеет собственного FSM —
// только фиксирует факт и статус контакта; вся логика регистрации
// переиспользуется из WhatsAppOnboardingService как есть.
model ProspectContact {
  id               String    @id @default(uuid())
  phone            String
  orderId          String
  order            Order     @relation(fields: [orderId], references: [id])
  firstContactedAt DateTime  @default(now())
  respondedAt      DateTime?
  convertedAt      DateTime?
  // sent -> responded (кнопка нажата) -> converted (needsReview создан) — либо
  // sent/responded -> ignored (таймаут без ответа, см. env.prospectIgnoreTimeoutDays,
  // или оператор вручную).
  status           String    @default("sent")
  leadSource       String    @default("cold_outreach")

  @@index([phone])
  @@index([status])
}

// ---------- Notifications / analytics / audit ----------

model NotificationLog {
  id             String              @id @default(uuid())
  channel        NotificationChannel
  templateKey    String
  recipientPhone String?
  supplierId     String?
  supplier       SupplierProfile?    @relation(fields: [supplierId], references: [id])
  orderId        String?
  payload        Json
  renderedText   String
  status         NotificationStatus  @default(SENT)
  errorMessage   String?
  createdAt      DateTime            @default(now())
  /// Идентификатор сообщения у провайдера. Нужен, чтобы связать отправку с
  /// асинхронным статусом доставки: сам вызов API возвращает успех, а отказ
  /// («нет WhatsApp», «окно закрыто») приходит отдельным вебхуком позже.
  /// Без этой связки status=SENT означал лишь «провайдер принял запрос».
  providerMessageId String?          @unique
  deliveredAt    DateTime?
  readAt         DateTime?

  @@index([orderId])
}

enum Language {
  RU
  KK
}

enum MessageDirection {
  IN
  OUT
}

/// Сырая стенограмма переписки в WhatsApp — обе стороны, все каналы.
/// Существующий ChatMessage покрывает только диалог на сайте, а вся сторона
/// поставщика живёт исключительно в WhatsApp: онбординг, «стоп», «баланс»,
/// согласие взять заявку. Без этой таблицы на вопрос «что мы ему написали и
/// что он ответил» ответить нечем, а восстановить задним числом нельзя.
///
/// Пишется на уровне провайдера, а не сервисов, — так в неё попадает и то,
/// что роутер с онбордингом шлют напрямую, минуя NotificationsService.
model WhatsAppMessage {
  id            String           @id @default(uuid())
  /// Номер контрагента (не наш) — по нему собирается лента диалога.
  phone         String
  direction     MessageDirection
  /// text | buttons | template | button_reply | image | unknown
  kind          String
  text          String?
  /// Для шаблона — его имя, для нажатия кнопки — payload. Именно payload
  /// показывает, что человек на самом деле выбрал.
  payload       String?
  /// Входящее, которое бот не понял и ответил общей фразой. Главный
  /// материал для улучшения: реальные формулировки, которые мы не держим.
  unrecognized  Boolean          @default(false)
  createdAt     DateTime         @default(now())

  @@index([phone, createdAt])
  @@index([unrecognized, createdAt])
}

enum NotificationChannel {
  SMS
  WHATSAPP
  TELEGRAM
  EMAIL
  PUSH
  CONSOLE
}

enum NotificationStatus {
  SENT
  FAILED
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  eventType String
  userId    String?
  orderId   String?
  channel   String?
  device    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([eventType, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorType  String
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
}

// ---------- Admin ----------

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(OPERATOR)
  name         String?
  createdAt    DateTime  @default(now())
}

enum AdminRole {
  ADMIN
  OPERATOR
}

model DispatchSettings {
  id               String   @id @default(uuid())
  // Max suppliers notified per broadcast (per publish or manual redispatch).
  waveSize         Int      @default(15)
  // Global default quiet-hours window for suppliers who haven't set their own
  // (see SupplierProfile.workingHoursStart/End) — null here falls back to
  // env.dispatchQuietHoursStart/End instead. Admin-tunable without a redeploy.
  quietHoursStart  String?
  quietHoursEnd    String?
  updatedAt        DateTime @updatedAt
}

/// Одна транзакция Kaspi по протоколу биллера (см. billing/kaspi-biller.service.ts).
///
/// Существует ради идемпотентности: протокол прямо требует, чтобы повторный
/// запрос с уже известным txn_id вернул результат предыдущей обработки, а не
/// провёл платёж второй раз. Kaspi повторяет запрос при любом обрыве связи,
/// так что «второй раз» — не гипотеза, а штатное поведение.
///
/// Заодно это журнал для сверки: банк ведёт учёт по txnDate, а не по времени
/// получения запроса, поэтому храним именно её.
model KaspiPayment {
  id          String           @id @default(uuid())
  /// Номер платежа в Kaspi. Ключ идемпотентности.
  txnId       String           @unique
  /// Наш номер оплаты, который возвращается в prv_txn. Протокол требует целое
  /// число, уникальное в нашей базе.
  prvTxnId    Int              @unique @default(autoincrement())
  /// Что плательщик ввёл в поле «номер счёта», до всякой обработки.
  account     String
  invoiceId   String?
  invoice     SubscriptionInvoice? @relation(fields: [invoiceId], references: [id])
  supplierId  String?
  supplier    SupplierProfile? @relation(fields: [supplierId], references: [id])
  /// Тенге. Целое: Kaspi шлёт дробное, но копеек в подписке нет.
  sumTenge    Int?
  /// Дата учёта платежа на стороне Kaspi — по ней идёт сверка взаиморасчётов.
  txnDate     DateTime?
  /// Код ответа, который мы вернули: 0 успех, 1 не найден, 5 прочая ошибка.
  result      Int
  comment     String?
  daysGranted Int?
  createdAt   DateTime         @default(now())

  @@index([account])
  @@index([createdAt])
}

/// Счёт на оплату подписки.
///
/// Существует потому, что платит не обязательно сам поставщик: за исполнителя
/// платят бухгалтер, жена, сын с другого телефона. Привязка к номеру
/// плательщика в этой ситуации находит не того человека или никого, поэтому
/// идентификатором в Kaspi служит номер счёта — протокол прямо разрешает
/// «номер заказа» наравне с лицевым счётом.
model SubscriptionInvoice {
  id          String          @id @default(uuid())
  /// Восьмизначное число, которое плательщик набирает в приложении банка.
  /// Случайное, а не по порядку: соседний номер по возрастанию — это чужой
  /// счёт, и подобрать его было бы тривиально.
  number      String          @unique
  supplierId  String
  supplier    SupplierProfile @relation(fields: [supplierId], references: [id])
  amountTenge Int
  periodDays  Int
  /// PENDING | PAID | CANCELLED
  status      String          @default("PENDING")
  /// После этой даты счёт не принимается к оплате: иначе однажды придёт
  /// платёж по счёту годичной давности с давно неактуальной ценой.
  expiresAt   DateTime
  paidAt      DateTime?
  createdAt   DateTime        @default(now())
  payments    KaspiPayment[]

  @@index([supplierId, status])
}

/// Что поставщик написал про конкретную заявку после того, как получил её.
///
/// Человек, которому только что прислали заявку с телефоном клиента,
/// следующим сообщением пишет про неё, а не про свою технику. Раньше такой
/// текст уходил в описание профиля: «Вроде договорились, клиент озвонится» —
/// самое ценное сообщение, какое сервис может получить, — оседало как
/// характеристика крана и терялось.
model SupplierOrderReply {
  id         String          @id @default(uuid())
  orderId    String
  order      Order           @relation(fields: [orderId], references: [id])
  supplierId String
  supplier   SupplierProfile @relation(fields: [supplierId], references: [id])
  text       String
  /// agreed | declined | comment
  outcome    String
  createdAt  DateTime        @default(now())

  @@index([orderId])
  @@index([supplierId])
}
