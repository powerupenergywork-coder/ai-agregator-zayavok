# Production .env for docker-compose.prod.yml — copy to `.env` on the server
# (/home/artur/aggregator/.env) and fill in the blanks. DATABASE_URL/REDIS_URL
# are NOT here on purpose — docker-compose.prod.yml sets those itself to the
# in-network postgres/redis hostnames, don't add them here or you'll override
# that with something that doesn't resolve inside the containers.
#
# Everything below WEB_URL/API_URL assumes nginx fronting on port 8002 with
# no domain yet (bare IP). Swap in a real domain later and rebuild the web
# image (NEXT_PUBLIC_API_URL is baked in at build time, not read at runtime).

# --- Core ---
NODE_ENV=production
API_PORT=3001
API_URL=http://85.159.24.131:8002/api
WEB_URL=http://85.159.24.131:8002
# Also passed as a docker build arg for the web image — see docker-compose.prod.yml.
NEXT_PUBLIC_API_URL=http://85.159.24.131:8002/api

# Generate with: openssl rand -hex 48
JWT_SECRET=REPLACE_ME

# --- Database (used to build DATABASE_URL inside docker-compose.prod.yml) ---
POSTGRES_USER=app
# Generate with: openssl rand -base64 24 | tr -dc 'a-zA-Z0-9' | head -c32
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=ai_zayavki

# --- Admin seed account (apps/api/prisma/seed.ts) ---
# Change these before running `prisma db seed` — the code defaults to
# admin@example.com/admin12345 if left blank, which you do NOT want live.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=REPLACE_ME

# --- Auth / OTP ---
TRUSTED_DEVICE_DAYS=3
OTP_CODE_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# --- SMS provider ---
SMS_PROVIDER=console
# SMS_PROVIDER=mobizon
# MOBIZON_API_KEY=

# --- AI provider ---
AI_PROVIDER=mock
# AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Storage ---
# local is fine for a first deploy — photos persist in the uploads_data
# docker volume. Switch to s3 later if you stand up real object storage.
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=order-photos
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# --- Maps / geocoding ---
MAPS_PROVIDER=none
TWOGIS_API_KEY=

# --- Broadcast dispatch ---
# Только начальное значение — при первом запуске из него создаётся запись
# настроек. Дальше размер волны хранится в базе и меняется в админке;
# правка здесь на работающем сервисе ничего не изменит.
DISPATCH_WAVE_SIZE=30

# --- Order completion check-in ---
ORDER_CHECKIN_DELAY_HOURS=24
ORDER_CHECKIN_AUTO_CLOSE_HOURS=48

# --- WhatsApp (GREEN-API) ---
WHATSAPP_PROVIDER=console
# WHATSAPP_PROVIDER=green-api
GREEN_API_BASE_URL=https://api.green-api.com
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=
# Generate with: openssl rand -hex 24
# Must match whatever you pass as webhookUrlToken when you run GREEN-API's
# SetSettings (see README).
WHATSAPP_WEBHOOK_TOKEN=REPLACE_ME

# --- WhatsApp (Meta Cloud API / WABA) ---
# WHATSAPP_PROVIDER=cloud-api
WHATSAPP_CLOUD_API_VERSION=v21.0
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
# Generate with: openssl rand -hex 24 — then enter the same value in Meta's
# app dashboard when registering the webhook callback URL
# (http://85.159.24.131:8002/api/whatsapp/cloud-webhook).
# Идентификатор WABA — из него берутся тексты утверждённых шаблонов для
# стенограммы. Без него в переписке вместо сообщения видны подстановки.
WHATSAPP_CLOUD_WABA_ID=
WHATSAPP_CLOUD_WEBHOOK_VERIFY_TOKEN=REPLACE_ME

# --- Billing (supplier notification subscription) ---
PAYMENT_PROVIDER=mock
# PAYMENT_PROVIDER=kaspi
# Пока PAYMENT_PROVIDER=mock, поставщику вместо ссылки на оплату уходит этот
# контакт: мок-ссылка включила бы платную подписку бесплатно.
SUPPORT_PHONE=+7 778 709 8251
# --- Приём платежей Kaspi (протокол биллера) ---
# Не шлюз: платёж создаёт банк, а не мы. Поставщик получает от нас номер
# счёта (8 цифр); оплатить может кто угодно — бухгалтер, родственник, с любого
# телефона. Плательщик вводит этот номер, и Kaspi дёргает наш endpoint
# https://kerektap.kz/api/kaspi/pay запросами check и pay. Ссылки на оплату в
# этой схеме не существует, поэтому PAYMENT_PROVIDER тут ни при чём.
# false = endpoint отвечает «ошибка провайдера» на всё. Включать только после
# того, как проверен TRUSTED_PROXY_HOPS (см. ниже) — иначе список адресов
# ничего не защищает.
KASPI_BILLER_ENABLED=false
# Название услуги в списке платежей Kaspi: по нему поставщик её ищет, и ровно
# оно подставляется в инструкцию, которую мы ему отправляем.
KASPI_SERVICE_NAME=KerekTap
# Сколько дней счёт принимается к оплате. Без срока однажды придёт платёж по
# счёту годичной давности с давно неактуальной ценой.
INVOICE_VALID_DAYS=30
# Прямая ссылка на оплату счёта в приложении Kaspi. Подстановки: {invoice} —
# номер счёта, {sum} — сумма. Kaspi именует параметры числовыми ID полей
# услуги, которые назначает при регистрации, поэтому вид примерно такой:
#   https://kaspi.kz/pay/KerekTap?service_id=00000&15988={invoice}&15989={sum}
# Номера полей и готовую ссылку присылает банк. Пока не прислал — оставить
# пустым: выдуманная ссылка это человек, который ткнул и не смог заплатить, а
# мы об этом даже не узнаем. Ссылка НЕ заменяет инструкцию: платят и с
# компьютера, и по пересланному номеру.
KASPI_PAY_URL_TEMPLATE=
# Формат ответа по умолчанию: xml или json. Протокол разрешает оба и ведёт с
# XML; что читает их парсер, выясняется на тестах. Запрос может переопределить
# параметром ?format= или заголовком Accept.
KASPI_RESPONSE_FORMAT=json
# Единственная защита, какую даёт протокол: подписи в нём нет вовсе.
# Через запятую; пусто = не пускать никого.
KASPI_ALLOWED_IPS=194.187.247.152,194.187.245.108,197.187.244.108,194.187.244.108
# Необязательный общий секрет — если банк согласится передавать постоянное
# значение в data1. Сверх адресов, а не вместо. Пусто = не проверять.
KASPI_SHARED_SECRET=
# На сколько записей отступить от КОНЦА X-Forwarded-For до настоящего адреса
# клиента. Основной источник — X-Real-IP, это лишь запасной путь.
# НЕ угадывать: открыть /api/kaspi/whoami, в том числе с подделанным
# заголовком X-Forwarded-For, и убедиться, что allowed не становится true.
# Ошибка здесь = любой желающий выписывает себе подписку одним запросом.
TRUSTED_PROXY_HOPS=0
# 5000 — временно, на период интеграции с Kaspi.
# При запуске приёма оплат — 10000.
SUBSCRIPTION_PRICE_TENGE=5000
SUBSCRIPTION_PERIOD_DAYS=30
FREE_NOTIFICATIONS_PER_MONTH=10

# Сколько дней держать стенограмму переписки в WhatsApp. Персональные данные:
# срок объявлен в политике конфиденциальности (п. 6), менять только вместе с ней.
WHATSAPP_TRANSCRIPT_RETENTION_DAYS=7
