{
  // Порог CI по зависимостям. Валит сборку на high и critical; moderate/low —
  // информативно, не блокируют (иначе транзитивы шумят и приучают к красному).
  "high": true,
  // Только рабочие зависимости — dev-инструменты в рантайм не попадают.
  "skip-dev": true,
  // Известные и осознанно принятые. Каждый — с причиной; пересматривать при
  // обновлении Nest.
  "allowlist": [
    // lodash _.template code injection: тянется транзитивом через
    // @nestjs/config, напрямую не используем (_.template с недоверенным
    // вводом у нас нет). Фикс — @nestjs/config@12 (major, тянет Nest 11);
    // уйдёт вместе с апгрейдом Nest.
    "GHSA-r5fr-rjxr-66jc"
  ]
}
