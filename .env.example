# --- Core ---
NODE_ENV=development
API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
JWT_SECRET=change-me-in-production

# --- Database / Queue ---
# Non-default host ports (5433/6380) — this machine already runs another
# Postgres/Redis stack on 5432/6379 for a different project (see docker-compose.yml).
DATABASE_URL=postgresql://app:app@localhost:5433/ai_zayavki
REDIS_URL=redis://localhost:6380

# --- Auth / OTP ---
# Trusted-device window: how long a phone stays verified on the same device without a new SMS code
TRUSTED_DEVICE_DAYS=3
OTP_CODE_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# --- SMS provider ---
# console = dev mode, logs the code to the API console instead of sending a real SMS
SMS_PROVIDER=console
# SMS_PROVIDER=mobizon
# MOBIZON_API_KEY=
# .kz and .com are separate installations with separate accounts — a key from
# one is rejected by the other, which looks like an invalid key.
MOBIZON_API_HOST=api.mobizon.kz
# Approved alphanumeric sender name; empty means the account default.
MOBIZON_SENDER_NAME=

# --- AI provider ---
# mock = deterministic offline classifier/extractor, no external calls, for local dev without a key
AI_PROVIDER=mock
# AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Storage ---
# local = writes to apps/api/uploads and serves via /uploads static route, zero setup
# s3 = real S3-compatible upload (works with the MinIO from docker-compose)
STORAGE_PROVIDER=local
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=order-photos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- Maps / geocoding ---
# none = free-text address only, no geocoding
MAPS_PROVIDER=none
# MAPS_PROVIDER=2gis
TWOGIS_API_KEY=

# --- Broadcast dispatch (overridable by admin at runtime) ---
DISPATCH_WAVE_SIZE=15

# --- Order completion check-in (lead-broadcast model — see README) ---
ORDER_CHECKIN_DELAY_HOURS=24
# Сколько ждать ответа на проверку статуса, прежде чем закрыть заявку
# автоматически. Имя должно совпадать с тем, что читает config/env.ts:
# ORDER_CHECKIN_ESCALATE_HOURS здесь не читался никем, и заявки закрывались
# через час (дефолт) вместо заданного срока.
ORDER_CHECKIN_AUTO_CLOSE_HOURS=48

# --- WhatsApp (GREEN-API) ---
# console = dev mode, logs outgoing messages instead of calling GREEN-API
WHATSAPP_PROVIDER=console
# WHATSAPP_PROVIDER=green-api
GREEN_API_BASE_URL=https://api.green-api.com
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=
# Checked against the Authorization header GREEN-API sends with every webhook
# (set the same value as webhookUrlToken when you run SetSettings — see README)
WHATSAPP_WEBHOOK_TOKEN=dev-webhook-token-change-me

# --- WhatsApp (Meta Cloud API / WABA) ---
# WHATSAPP_PROVIDER=cloud-api
WHATSAPP_CLOUD_API_VERSION=v21.0
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
# Pick any value, then enter the same one in Meta's app dashboard when you
# register the webhook callback URL (.../whatsapp/cloud-webhook) — Meta echoes
# it back on the verification handshake to prove you own the endpoint.
WHATSAPP_CLOUD_WEBHOOK_VERIFY_TOKEN=dev-verify-token-change-me

# --- Billing (supplier notification subscription) ---
# mock = instant fake "payment" via GET /billing/mock-confirm/:reference, no real money involved
PAYMENT_PROVIDER=mock
# PAYMENT_PROVIDER=kaspi
# Куда звать поставщика, пока принимать оплату нечем (PAYMENT_PROVIDER=mock).
SUPPORT_PHONE=+7 778 709 8251
# --- Приём платежей Kaspi (протокол биллера) ---
# Не шлюз: платёж создаёт банк, а не мы. Поставщик получает от нас номер
# счёта (8 цифр); оплатить может кто угодно — бухгалтер, родственник, с любого
# телефона. Плательщик вводит этот номер, и Kaspi дёргает наш endpoint
# https://kerektap.kz/api/kaspi/pay запросами check и pay. Ссылки на оплату в
# этой схеме не существует, поэтому PAYMENT_PROVIDER тут ни при чём.
# false = endpoint отвечает «ошибка провайдера» на всё. Включать только после
# того, как проверен TRUSTED_PROXY_HOPS (см. ниже) — иначе список адресов
# ничего не защищает.
KASPI_BILLER_ENABLED=false
# Название услуги в списке платежей Kaspi: по нему поставщик её ищет, и ровно
# оно подставляется в инструкцию, которую мы ему отправляем.
KASPI_SERVICE_NAME=KerekTap
# Сколько дней счёт принимается к оплате. Без срока однажды придёт платёж по
# счёту годичной давности с давно неактуальной ценой.
INVOICE_VALID_DAYS=30
# Прямая ссылка на оплату счёта в приложении Kaspi; {invoice} подставляется
# номером счёта. Точный вид задаёт банк при регистрации услуги — пока формат
# не получен, оставить пустым: выдуманная ссылка это человек, который ткнул и
# не смог заплатить, а мы об этом даже не узнаем. Ссылка НЕ заменяет
# инструкцию: платят и с компьютера, и по пересланному номеру.
KASPI_PAY_URL_TEMPLATE=
# Единственная защита, какую даёт протокол: подписи в нём нет вовсе.
# Через запятую; пусто = не пускать никого.
KASPI_ALLOWED_IPS=194.187.247.152,194.187.245.108,197.187.244.108,194.187.244.108
# Необязательный общий секрет — если банк согласится передавать постоянное
# значение в data1. Сверх адресов, а не вместо. Пусто = не проверять.
KASPI_SHARED_SECRET=
# Сколько записей в X-Forwarded-For принадлежит нашим собственным прокси.
# Значение НЕ угадывать: открыть /api/kaspi/whoami и посмотреть цепочку.
# Ошибка здесь означает, что проверку по IP можно обойти своим заголовком.
TRUSTED_PROXY_HOPS=2
# Placeholder values — not a real pricing decision, just what the mock charges
SUBSCRIPTION_PRICE_TENGE=5000
SUBSCRIPTION_PERIOD_DAYS=30
FREE_NOTIFICATIONS_PER_MONTH=10

# Сколько дней держать стенограмму переписки в WhatsApp. Персональные данные:
# срок объявлен в политике конфиденциальности (п. 6), менять только вместе с ней.
WHATSAPP_TRANSCRIPT_RETENTION_DAYS=7

# --- Seeding ---
# Demo suppliers (+7701000000x, Астана) for local smoke tests of the matching
# engine. Off by default: the dispatcher can't distinguish them from real
# suppliers, so on a live server they'd be handed real clients' phone numbers.
SEED_DEMO_SUPPLIERS=true

