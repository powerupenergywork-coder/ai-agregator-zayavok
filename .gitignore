node_modules/
dist/
.next/
# Ignore every .env* by default and only allowlist the committed templates —
# safer than listing exact filenames, catches .env.production etc. too.
.env*
!.env.example
!.env.production.example
*.log
# Боевые TLS-сертификаты живут в рабочем дереве на сервере. Ключ там
# настоящий, и без этой строки он в одном `git add -A` от того, чтобы
# уехать в публичную историю репозитория.
nginx/certs/
.turbo/
apps/api/generated/
packages/shared/dist/
apps/api/uploads/*
!apps/api/uploads/.gitkeep
.DS_Store
